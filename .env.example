# Copy this file to .env and fill in real values before running docker compose.
# .env is gitignored — never commit real secrets.

# Generate with:  mix phx.gen.secret
SECRET_KEY_BASE=

# Public hostname the app is served from (used for URLs / force_ssl exclusion).
PHX_HOST=localhost

# How the site is reached publicly — drives URL generation in magic-link emails.
# A non-default port (not 80 for http, not 443 for https) is included in links.
# Local compose (plain HTTP on :4000):
PHX_SCHEME=http
PHX_PORT=4000
# Behind a TLS terminator, use instead:
#   PHX_SCHEME=https
#   PHX_PORT=443

# Database credentials for the TimescaleDB container.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=dtu_app_prod

# DB connection pool size.
POOL_SIZE=15

# Embedded MQTT broker.
MQTT_BROKER_ENABLED=true

# DNS alias shown to users as the MQTT broker host in the device setup modal.
# Set this when MQTT runs on a different domain than the web app (e.g. mqtt.example.com).
# Leave empty to use PHX_HOST (broker and web app on the same host).
MQTT_HOST=

# Transactional email delivery — standard SMTP, configured entirely via env vars.
#
# Local dev (default): point SMTP_RELAY at the mailpit sidecar from docker-compose.
# Bring it up with `docker compose up -d mailpit` and inspect captured emails at
# http://localhost:8025. Mailpit accepts any sender and doesn't require auth.
#
# Production: point SMTP_RELAY at your real relay (SES, Mailgun, Postmark,
# Fastmail, self-hosted Postfix, ...) and set SMTP_USERNAME / SMTP_PASSWORD /
# SMTP_TLS to whatever that relay requires. Examples:
#
#   SES SMTP (us-east-1):
#     SMTP_RELAY=email-smtp.us-east-1.amazonaws.com
#     SMTP_PORT=587
#     SMTP_TLS=if_available
#     SMTP_USERNAME=<SMTP username from SES console>
#     SMTP_PASSWORD=<SMTP password from SES console>
#
#   Mailgun:
#     SMTP_RELAY=smtp.mailgun.org
#     SMTP_PORT=587
#     SMTP_TLS=if_available
#     SMTP_USERNAME=postmaster@mg.example.com
#     SMTP_PASSWORD=<api key>
#
#   Postmark (port 2525 if 25/465/587 are blocked outbound):
#     SMTP_RELAY=smtp.postmarkapp.com
#     SMTP_PORT=587
#     SMTP_TLS=if_available
#     SMTP_USERNAME=<server token>
#     SMTP_PASSWORD=<server token>
SMTP_RELAY=localhost
SMTP_PORT=1025
SMTP_DOMAIN=localhost
# SMTP_TLS: "always" (implicit TLS, usually :465) | "if_available" (STARTTLS,
# usually :587, default) | "never" (plain SMTP, e.g. local Mailpit).
SMTP_TLS=never
# SMTP_AUTH_MODE: "auto" (authenticate iff both username + password are set,
# default) | "always" (require auth) | "never" (skip auth, e.g. local Mailpit).
SMTP_AUTH_MODE=never
# SMTP_USERNAME=
# SMTP_PASSWORD=

# Sender address. Must be accepted by the relay — for SES/Mailgun/Postmark
# that means a verified-sender (or verified-domain) address; for Mailpit
# anything works. Use the "Name <address@domain>" form, e.g.
# "DtuApp <noreply@mail.example.com>".
MAIL_FROM=DtuApp <noreply@localhost>

# Web Push (VAPID, RFC 8292) keys for native browser notifications
# delivered by the service worker when no tab is open. Generate with:
#   bin/gen-vapid                          # writes to ./.env
#   bin/gen-vapid --subject mailto:admin@example.com  # for prod
# Or run the library's task directly:
#   mix web_push.gen.vapid
# Paste the resulting URL-safe base64 public_key / private_key below.
# Without these the in-page notification path (PubSub → JS hook) keeps
# working, but native OS notifications are disabled.
# In production all three must be set explicitly; in dev the server
# generates a fresh keypair on each boot and logs it for convenience.
# VAPID_SUBJECT must be a `mailto:` or `https://` URL the push service
# uses to contact the operator (required by RFC 8292 §2).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@localhost
