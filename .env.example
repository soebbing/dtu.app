# Copy this file to .env and fill in real values before running docker compose.
# .env is gitignored — never commit real secrets.

# Generate with:  mix phx.gen.secret
SECRET_KEY_BASE=

# Public hostname the app is served from (used for URLs / force_ssl exclusion).
PHX_HOST=localhost

# How the site is reached publicly — drives URL generation in magic-link emails.
# A non-default port (not 80 for http, not 443 for https) is included in links.
# Local compose (plain HTTP on :4000):
PHX_SCHEME=http
PHX_PORT=4000
# Behind a TLS terminator, use instead:
#   PHX_SCHEME=https
#   PHX_PORT=443

# Database credentials for the TimescaleDB container.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=dtu_app_prod

# DB connection pool size.
POOL_SIZE=15

# Embedded MQTT broker.
MQTT_BROKER_ENABLED=true

# DNS alias shown to users as the MQTT broker host in the device setup modal.
# Set this when MQTT runs on a different domain than the web app (e.g. mqtt.example.com).
# Leave empty to use PHX_HOST (broker and web app on the same host).
MQTT_HOST=

# Transactional email delivery. Three modes, picked in order of precedence:
#   1. RESEND_API_KEY set  → real email via the Resend API (production)
#   2. MAIL_DELIVERY=mailpit → local SMTP capture server (development)
#   3. neither set       → in-memory mailer; emails swallowed, magic-link
#                          URL appears in the server logs
#
# To use the local mailpit: leave RESEND_API_KEY empty and set
# MAIL_DELIVERY=mailpit. Bring the mailpit service up first
# (`docker compose up -d mailpit`) — emails can then be inspected in a
# web UI at http://localhost:8025.
MAIL_DELIVERY=mailpit
RESEND_API_KEY=
# Sender address — must be on a domain you have verified in Resend, or any
# address when using the local mailpit (it accepts everything).
# Use the "Name <address@domain>" form, e.g. "DtuApp <noreply@mail.example.com>".
MAIL_FROM=DtuApp <noreply@localhost>

# SMTP server (used when MAIL_DELIVERY=mailpit).
#
# SMTP_RELAY defaults to "localhost" so that `mix phx.server` (running on the
# host) can reach the mailpit container via the published port 1025. If you
# instead run the app inside the docker compose stack, override SMTP_RELAY
# with the docker service name so it resolves via compose's internal DNS:
#
#   SMTP_RELAY=mailpit mix phx.server                # outside docker
#   SMTP_RELAY=mailpit docker compose up             # app also in docker
SMTP_RELAY=localhost
SMTP_PORT=1025
SMTP_DOMAIN=localhost

# Web Push (VAPID, RFC 8292) keys for native browser notifications
# delivered by the service worker when no tab is open. Generate with:
#   bin/gen-vapid                          # writes to ./.env
#   bin/gen-vapid --subject mailto:admin@example.com  # for prod
# Or run the library's task directly:
#   mix web_push.gen.vapid
# Paste the resulting URL-safe base64 public_key / private_key below.
# Without these the in-page notification path (PubSub → JS hook) keeps
# working, but native OS notifications are disabled.
# In production all three must be set explicitly; in dev the server
# generates a fresh keypair on each boot and logs it for convenience.
# VAPID_SUBJECT must be a `mailto:` or `https://` URL the push service
# uses to contact the operator (required by RFC 8292 §2).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@localhost
