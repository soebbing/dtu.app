<!DOCTYPE html>
<html lang={assigns[:locale] || "en"}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="csrf-token" content={get_csrf_token()} />

    <%!-- PWA: installable app metadata --%>
    <link rel="manifest" href={~p"/manifest.webmanifest"} />
    <meta name="theme-color" content="#10b981" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#09090b" media="(prefers-color-scheme: dark)" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="dtu.app" />
    <link rel="apple-touch-icon" href={~p"/images/icon-192.png"} />
    <link rel="icon" type="image/svg+xml" href={~p"/images/logo.svg"} />

    <.live_title default="dtu.app" suffix=" · solar telemetry" phx-no-format>{assigns[:page_title]}</.live_title>
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
    <script>
      (() => {
        const systemTheme = () => matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";

        const setTheme = (theme) => {
          if (theme === "system") {
            localStorage.removeItem("phx:theme");
            document.documentElement.setAttribute("data-theme", systemTheme());
            document.documentElement.setAttribute("data-theme-source", "system");
          } else {
            localStorage.setItem("phx:theme", theme);
            document.documentElement.setAttribute("data-theme", theme);
            document.documentElement.setAttribute("data-theme-source", "user");
          }
        };
        if (!document.documentElement.hasAttribute("data-theme")) {
          setTheme(localStorage.getItem("phx:theme") || "system");
        }
        window.addEventListener("storage", (e) => e.key === "phx:theme" && setTheme(e.newValue || "system"));
        
        window.addEventListener("phx:set-theme", (e) => setTheme(e.target.dataset.phxTheme));

        matchMedia("(prefers-color-scheme: dark)").addEventListener("change", (e) => {
          if (document.documentElement.getAttribute("data-theme-source") === "system") {
            document.documentElement.setAttribute("data-theme", systemTheme());
          }
        });
      })();

      // Close the mobile burger menu when the user clicks outside it.
      // The <details> element toggles open/closed on <summary> click;
      // this listener prevents the menu from getting stuck open when
      // the user taps the page content. Bootstrap's dropdown.js uses
      // the same pattern — single document-level click, delegated
      // close — kept inline here because the burger menu is the only
      // dropdown in the navbar.
      (() => {
        document.addEventListener("click", (e) => {
          const burger = document.getElementById("nav-burger");
          if (!burger || !burger.open) return;
          if (burger.contains(e.target)) return;
          burger.removeAttribute("open");
        });
      })();
    </script>
  </head>
  <body class="bg-zinc-50 text-zinc-900 dark:bg-zinc-950 dark:text-zinc-50 min-h-screen transition-colors duration-250 flex flex-col antialiased">
    <!-- Unified Glassmorphic Navbar -->
    <header class="sticky top-0 z-50 w-full border-b border-zinc-200/50 dark:border-zinc-900/60 bg-white/70 dark:bg-zinc-950/75 backdrop-blur-md">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="flex h-16 items-center justify-between">
          <div class="flex items-center gap-6">
            <a href="/" class="flex items-center gap-2 group">
              <img
                src={~p"/images/logo.svg"}
                width="28"
                class="group-hover:scale-105 transition duration-300"
              />
              <span class="font-bold text-base tracking-tight bg-gradient-to-r from-emerald-500 to-amber-500 bg-clip-text text-transparent">dtu.app</span>
            </a>
            <nav class="hidden md:flex items-center gap-6">
              <%= if @current_scope && @current_scope.user do %>
                <.link
                  navigate={~p"/dashboard"}
                  class="text-sm font-medium text-zinc-655 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-200 transition"
                >{gettext("Dashboard")}</.link>
                <.link
                  navigate={~p"/devices"}
                  class="text-sm font-medium text-zinc-655 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-200 transition"
                >{gettext("DTUs")}</.link>
              <% end %>
            </nav>
          </div>
          <div class="flex items-center gap-4">
            <!-- Network Status Indicator -->
            <NetworkStatusIndicator.network_status_indicator
              show_text={false}
              show_detailed={false}
            />
            <Layouts.theme_toggle />

            <ul class="hidden md:flex items-center gap-3">
              <%= if @current_scope && @current_scope.user do %>
                <li class="hidden sm:inline text-xs text-zinc-500 dark:text-zinc-400 font-mono">
                  {@current_scope.user.email}
                </li>
                <%!-- "Manage Devices" lives in the desktop right-side
                     cluster (between email and Settings) so users on
                     a wide viewport never have to dig for it. The
                     same link is also in the burger menu on mobile. --%>
                <li>
                  <.link
                    href={~p"/devices"}
                    class="text-sm font-medium text-zinc-600 hover:text-zinc-950 dark:text-zinc-400 dark:hover:text-zinc-200 transition"
                  >{gettext("Manage Devices")}</.link>
                </li>
                <%!-- Notifications preferences: opt in/out of browser
                     notifications for DTU connection state changes and
                     the daily sun-down summary. --%>
                <li>
                  <.link
                    href={~p"/notifications"}
                    id="navbar-notifications"
                    class="text-sm font-medium text-zinc-600 hover:text-zinc-950 dark:text-zinc-400 dark:hover:text-zinc-200 transition"
                  >{gettext("Notifications")}</.link>
                </li>
                <li>
                  <.link
                    href={~p"/users/settings"}
                    class="text-sm font-medium text-zinc-600 hover:text-zinc-950 dark:text-zinc-400 dark:hover:text-zinc-200 transition"
                  >{gettext("Settings")}</.link>
                </li>
                <li>
                  <.link
                    href={~p"/users/log-out"}
                    method="delete"
                    class="text-sm font-medium text-zinc-650 hover:text-zinc-950 dark:text-zinc-300 dark:hover:text-zinc-100 bg-zinc-200/50 dark:bg-zinc-800/40 px-3 py-1.5 rounded-lg transition"
                  >{gettext("Log out")}</.link>
                </li>
              <% else %>
                <li>
                  <.link
                    href={~p"/users/log-in"}
                    class="text-sm font-medium text-zinc-600 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-200 transition"
                  >{gettext("Log in")}</.link>
                </li>
                <li>
                  <.link
                    href={~p"/users/register"}
                    class="text-sm font-medium bg-emerald-500 hover:bg-emerald-400 text-zinc-950 px-3.5 py-1.5 rounded-lg transition font-semibold shadow-sm shadow-emerald-500/10"
                  >{gettext("Register")}</.link>
                </li>
              <% end %>
            </ul>

            <%!-- Burger menu: visible on mobile, hidden on md+. Contains
                 the right-side controls (theme toggle, account links,
                 and a "Manage Devices" link) that the desktop nav
                 shows inline. Using <details> for a no-JS toggle +
                 a relative wrapper so the dropdown panel anchors to
                 the hamburger. --%>
            <details
              id="nav-burger"
              class="relative md:hidden"
              phx-no-format
            >
              <summary
                class="list-none cursor-pointer p-2 rounded-lg text-zinc-700 hover:bg-zinc-200/50 dark:text-zinc-200 dark:hover:bg-zinc-800/40 transition flex items-center justify-center"
                aria-label={gettext("Open menu")}
                id="nav-burger-toggle"
              >
                <%!-- Hamburger icon (heroicons bars-3). --%>
                <.icon name="hero-bars-3" class="h-6 w-6" />
              </summary>
              <div
                class="absolute right-0 mt-2 w-56 rounded-xl border border-zinc-200 dark:border-zinc-700 bg-white dark:bg-zinc-800 shadow-lg ring-1 ring-black/5 dark:ring-white/5 p-2 z-50"
                id="nav-burger-panel"
              >
                <ul class="flex flex-col gap-1">
                  <%= if @current_scope && @current_scope.user do %>
                    <li class="px-2 py-1 text-xs text-zinc-500 dark:text-zinc-400 font-mono truncate">
                      {@current_scope.user.email}
                    </li>
                    <li>
                      <.link
                        href={~p"/devices"}
                        class="flex items-center gap-2 px-2 py-2 rounded-lg text-sm font-medium text-zinc-700 hover:bg-zinc-100 dark:text-zinc-200 dark:hover:bg-zinc-700/50 transition"
                      >
                        <.icon name="hero-cog-6-tooth" class="h-4 w-4" />
                        {gettext("Manage Devices")}
                      </.link>
                    </li>
                    <li>
                      <.link
                        href={~p"/notifications"}
                        id="burger-notifications"
                        class="flex items-center gap-2 px-2 py-2 rounded-lg text-sm font-medium text-zinc-700 hover:bg-zinc-100 dark:text-zinc-200 dark:hover:bg-zinc-700/50 transition"
                      >
                        <.icon name="hero-bell" class="h-4 w-4" />
                        {gettext("Notifications")}
                      </.link>
                    </li>
                    <li>
                      <.link
                        href={~p"/users/settings"}
                        class="flex items-center gap-2 px-2 py-2 rounded-lg text-sm font-medium text-zinc-700 hover:bg-zinc-100 dark:text-zinc-200 dark:hover:bg-zinc-700/50 transition"
                      >
                        <.icon name="hero-user-circle" class="h-4 w-4" />
                        {gettext("Settings")}
                      </.link>
                    </li>
                    <li>
                      <.link
                        href={~p"/users/log-out"}
                        method="delete"
                        class="flex items-center gap-2 px-2 py-2 rounded-lg text-sm font-medium text-zinc-700 hover:bg-zinc-100 dark:text-zinc-200 dark:hover:bg-zinc-700/50 transition"
                      >
                        <.icon name="hero-arrow-right-start-on-rectangle" class="h-4 w-4" />
                        {gettext("Log out")}
                      </.link>
                    </li>
                  <% else %>
                    <li>
                      <.link
                        href={~p"/users/log-in"}
                        class="flex items-center gap-2 px-2 py-2 rounded-lg text-sm font-medium text-zinc-700 hover:bg-zinc-100 dark:text-zinc-200 dark:hover:bg-zinc-700/50 transition"
                      >
                        {gettext("Log in")}
                      </.link>
                    </li>
                    <li>
                      <.link
                        href={~p"/users/register"}
                        class="flex items-center gap-2 px-2 py-2 rounded-lg text-sm font-semibold bg-emerald-500 hover:bg-emerald-400 text-zinc-950 transition"
                      >
                        {gettext("Register")}
                      </.link>
                    </li>
                  <% end %>
                </ul>
              </div>
            </details>
          </div>
        </div>
      </div>
    </header>

    <div class="flex-1 flex flex-col">
      {@inner_content}
    </div>

    <footer class="border-t border-zinc-200 dark:border-zinc-800 bg-zinc-50/50 dark:bg-zinc-950/50 backdrop-blur-sm">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-2.5 flex flex-wrap items-center justify-between gap-x-6 gap-y-1 text-xs text-zinc-500 dark:text-zinc-400">
        <nav aria-label={gettext("Legal")} class="flex items-center gap-4">
          <.link
            navigate={~p"/privacy"}
            class="hover:text-zinc-700 dark:hover:text-zinc-200 transition"
          >
            {gettext("Privacy")}
          </.link>
          <.link
            navigate={~p"/imprint"}
            class="hover:text-zinc-700 dark:hover:text-zinc-200 transition"
          >
            {gettext("Imprint")}
          </.link>
        </nav>
        <span
          class="font-mono text-[10px] tracking-wide text-zinc-400 dark:text-zinc-500"
          title={gettext("Currently-running release")}
        >
          {@version}
        </span>
      </div>
    </footer>
  </body>
</html>
