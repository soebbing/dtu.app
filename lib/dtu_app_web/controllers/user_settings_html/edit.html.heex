<Layouts.app flash={@flash} current_scope={@current_scope}>
  <div class="text-center">
    <.header>
      {gettext("Account Settings")}
      <:subtitle>{gettext("Manage your account email address and password settings")}</:subtitle>
    </.header>
  </div>

  <%!-- Passkey management. Hidden entirely when the kill switch is off so
       the feature can be disabled at runtime without a deploy. The card is
       the PasskeyFlow hook's root: the hook binds the "Add a passkey"
       button, reads the friendly-name input, and writes failures into the
       [data-passkey-error] node. The remove links POST (not DELETE) because
       the route is a POST and Plug.MethodOverride would rewrite a
       method="delete" link into a DELETE that matches nothing. --%>
  <div
    :if={Application.get_env(:dtu_app, :passkeys_enabled, true)}
    id="passkeys-card"
    phx-hook="PasskeyFlow"
    data-kind="registration"
  >
    <.header>
      {gettext("Passkeys")}
      <:subtitle>{gettext("Sign in faster on this device and others.")}</:subtitle>
    </.header>

    <p :if={@passkeys == []} class="mt-4 text-sm text-zinc-500 dark:text-zinc-400">
      {gettext("No passkeys yet — add one to skip the password next time.")}
    </p>

    <ul
      :if={@passkeys != []}
      class="mt-4 divide-y divide-zinc-200 dark:divide-zinc-800"
    >
      <li :for={pk <- @passkeys} class="flex items-center justify-between py-3">
        <div>
          <div class="text-sm font-medium text-zinc-900 dark:text-white">
            {pk.friendly_name}
          </div>
          <div class="text-xs text-zinc-500 dark:text-zinc-400">
            {last_used_label(pk)}
          </div>
        </div>
        <.link
          href={~p"/users/settings/passkeys/#{pk.id}/delete"}
          method="post"
          data-confirm={gettext("Remove this passkey? You won't be able to sign in with it.")}
          class="text-sm text-rose-600 hover:text-rose-700"
        >
          {gettext("Remove")}
        </.link>
      </li>
    </ul>

    <div class="mt-4 flex items-center gap-3">
      <input
        type="text"
        name="friendly_name"
        placeholder={gettext("Friendly name (e.g. MacBook Touch ID)")}
        class="w-full rounded-lg border border-zinc-300 dark:border-zinc-700 bg-white dark:bg-zinc-900 px-3 py-2 text-sm"
      />
      <button
        type="button"
        data-passkey-action="start"
        data-loading-label={gettext("Waiting for authenticator…")}
        class="shrink-0 bg-emerald-500 hover:bg-emerald-400 text-zinc-950 font-semibold px-4 py-2 rounded-lg transition"
      >
        {gettext("Add a passkey")}
      </button>
    </div>

    <div data-passkey-error hidden role="alert" class="mt-3 text-sm text-rose-600"></div>
  </div>

  <div :if={Application.get_env(:dtu_app, :passkeys_enabled, true)} class="divider" />

  <.form :let={f} for={@email_changeset} action={~p"/users/settings"} id="update_email">
    <input type="hidden" name="action" value="update_email" />

    <.input
      field={f[:email]}
      type="email"
      label={gettext("Email")}
      autocomplete="username"
      spellcheck="false"
      required
    />

    <.button variant="primary" phx-disable-with={gettext("Changing...")}>
      {gettext("Change Email")}
    </.button>
  </.form>

  <div class="divider" />

  <.form :let={f} for={@password_changeset} action={~p"/users/settings"} id="update_password">
    <input type="hidden" name="action" value="update_password" />

    <.input
      field={f[:password]}
      type="password"
      label={gettext("New password")}
      autocomplete="new-password"
      spellcheck="false"
      required
    />
    <.input
      field={f[:password_confirmation]}
      type="password"
      label={gettext("Confirm new password")}
      autocomplete="new-password"
      spellcheck="false"
      required
    />
    <.button variant="primary" phx-disable-with={gettext("Changing...")}>
      {gettext("Save Password")}
    </.button>
  </.form>

  <div class="divider" />

  <%!-- Energy rate for the dashboard's "Saved this month" card. The
       form posts a decimal €/kWh value as a plain string; the
       User.settings_changeset/2 converts it to whole cents and casts
       into the cents_per_kwh column. The hidden action routes to
       `update_settings/2` in UserSettingsController. --%>
  <.form :let={_f} for={@settings_changeset} action={~p"/users/settings"} id="update_settings">
    <input type="hidden" name="action" value="update_settings" />

    <.input
      name="euros_per_kwh"
      id="euros_per_kwh"
      type="number"
      step="0.01"
      min="0.01"
      max="100"
      label={gettext("Energy rate (€/kWh)")}
      value={
        # Prefill the input with the user's stored €/kWh rate.
        #
        # `fetch_field/2` returns the changeset's `:changes` value if
        # present, otherwise the `:data` value. On a fresh GET the
        # settings_changeset/2 always puts something in `:changes`
        # (the empty-input branch produces `cents = nil`), so it never
        # falls back to `:data` and the input renders empty even
        # though the user has a stored rate. Read `:data` first
        # (the user's actual stored value), then fall back to
        # `:changes` for the post-failed-POST case where the user has
        # typed something. Treat any `nil` (cleared field) as empty.
        cents =
          case @settings_changeset do
            %Ecto.Changeset{data: %DtuApp.Accounts.User{cents_per_kwh: cents}}
            when is_integer(cents) ->
              cents

            _ ->
              case Ecto.Changeset.fetch_field(@settings_changeset, :cents_per_kwh) do
                {_, cents} when is_integer(cents) -> cents
                _ -> nil
              end
          end

        case cents do
          c when is_integer(c) -> :erlang.float_to_binary(c / 100.0, decimals: 2)
          _ -> ""
        end
      }
      placeholder="0.32"
    />
    <p class="mt-1 text-xs text-zinc-500 dark:text-zinc-400">
      {gettext(
        "Used to calculate how much your solar production saved you this month. Leave empty to hide the savings card."
      )}
    </p>

    <%= if error = Keyword.get(@settings_changeset.errors, :cents_per_kwh) do %>
      <p class="mt-1 text-sm text-rose-600 dark:text-rose-400">
        {elem(error, 0)}
      </p>
    <% end %>

    <%!-- Language for the dashboard UI, browser notifications, and
         transactional emails. Mirrors the same set `Plugs.Locale`
         and `User.@supported_locales` resolve against; the changeset
         rejects anything else. Prefilled from the user's stored
         locale so re-opening the page doesn't drop the selection. --%>
    <.input
      name="locale"
      id="locale"
      type="select"
      label={gettext("Language")}
      value={@current_scope.user.locale}
      options={[
        {gettext("English"), "en"},
        {gettext("Deutsch"), "de"},
        {gettext("Français"), "fr"}
      ]}
    />

    <%= if error = Keyword.get(@settings_changeset.errors, :locale) do %>
      <p class="mt-1 text-sm text-rose-600 dark:text-rose-400">
        {elem(error, 0)}
      </p>
    <% end %>

    <.button variant="primary" phx-disable-with={gettext("Saving...")}>
      {gettext("Save Settings")}
    </.button>
  </.form>
</Layouts.app>
