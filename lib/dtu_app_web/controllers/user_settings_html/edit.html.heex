<Layouts.app flash={@flash} current_scope={@current_scope}>
  <div class="text-center">
    <.header>
      {gettext("Account Settings")}
      <:subtitle>{gettext("Manage your account email address and password settings")}</:subtitle>
    </.header>
  </div>

  <%!-- Passkey management. Hidden entirely when the kill switch is off so
       the feature can be disabled at runtime without a deploy. The card is
       the PasskeyFlow hook's root: the hook binds the "Add a passkey"
       button, reads the friendly-name input, and writes failures into the
       [data-passkey-error] node. The remove links POST (not DELETE) because
       the route is a POST and Plug.MethodOverride would rewrite a
       method="delete" link into a DELETE that matches nothing. --%>
  <div
    :if={Application.get_env(:dtu_app, :passkeys_enabled, true)}
    id="passkeys-card"
    phx-hook="PasskeyFlow"
    data-kind="registration"
  >
    <.header>
      {gettext("Passkeys")}
      <:subtitle>{gettext("Sign in faster on this device and others.")}</:subtitle>
    </.header>

    <p :if={@passkeys == []} class="mt-4 text-sm text-zinc-500 dark:text-zinc-400">
      {gettext("No passkeys yet — add one to skip the password next time.")}
    </p>

    <ul
      :if={@passkeys != []}
      class="mt-4 divide-y divide-zinc-200 dark:divide-zinc-800"
    >
      <li :for={pk <- @passkeys} class="flex items-center justify-between py-3">
        <div>
          <div class="text-sm font-medium text-zinc-900 dark:text-white">
            {pk.friendly_name}
          </div>
          <div class="text-xs text-zinc-500 dark:text-zinc-400">
            {last_used_label(pk)}
          </div>
        </div>
        <.link
          href={~p"/users/settings/passkeys/#{pk.id}/delete"}
          method="post"
          data-confirm={gettext("Remove this passkey? You won't be able to sign in with it.")}
          class="text-sm text-rose-600 hover:text-rose-700"
        >
          {gettext("Remove")}
        </.link>
      </li>
    </ul>

    <div class="mt-4 flex items-center gap-3">
      <input
        type="text"
        name="friendly_name"
        placeholder={gettext("Friendly name (e.g. MacBook Touch ID)")}
        class="w-full rounded-lg border border-zinc-300 dark:border-zinc-700 bg-white dark:bg-zinc-900 px-3 py-2 text-sm"
      />
      <button
        type="button"
        data-passkey-action="start"
        data-loading-label={gettext("Waiting for authenticator…")}
        class="shrink-0 bg-emerald-500 hover:bg-emerald-400 text-zinc-950 font-semibold px-4 py-2 rounded-lg transition"
      >
        {gettext("Add a passkey")}
      </button>
    </div>

    <div data-passkey-error hidden role="alert" class="mt-3 text-sm text-rose-600"></div>
  </div>

  <div :if={Application.get_env(:dtu_app, :passkeys_enabled, true)} class="divider" />

  <.form :let={f} for={@email_changeset} action={~p"/users/settings"} id="update_email">
    <input type="hidden" name="action" value="update_email" />

    <.input
      field={f[:email]}
      type="email"
      label={gettext("Email")}
      autocomplete="username"
      spellcheck="false"
      required
    />

    <.button variant="primary" phx-disable-with={gettext("Changing...")}>
      {gettext("Change Email")}
    </.button>
  </.form>

  <div class="divider" />

  <.form :let={f} for={@password_changeset} action={~p"/users/settings"} id="update_password">
    <input type="hidden" name="action" value="update_password" />

    <.input
      field={f[:password]}
      type="password"
      label={gettext("New password")}
      autocomplete="new-password"
      spellcheck="false"
      required
    />
    <.input
      field={f[:password_confirmation]}
      type="password"
      label={gettext("Confirm new password")}
      autocomplete="new-password"
      spellcheck="false"
      required
    />
    <.button variant="primary" phx-disable-with={gettext("Changing...")}>
      {gettext("Save Password")}
    </.button>
  </.form>

  <div class="divider" />

  <%!-- Location card. When the user has a stored lat/lon we show it
       read-only (formatted as `52.5200° N, 13.4050° E` — 4-decimal
       precision is enough to identify a city block and matches what
       most consumer GPS chips report), with two actions: refresh
       (re-request the browser permission and overwrite) and clear
       (POST through with empty coords to nil both fields
       atomically). When unset we show the same Share-location
       affordance the dashboard cloud-cover card uses, plus a short
       explanation of why the app wants it.

       The form is a separate dedicated form (not folded into the
       €/kWh one) because the geolocation flow is JS-driven: the
       inline script at the bottom of this section intercepts the
       Share-location / Update-location click, calls
       navigator.geolocation.getCurrentPosition, and submits the
       form programmatically. Folding it into the existing form
       would require either disabling that button when the user has
       typed something into the €/kWh field, or always submitting
       all fields together — neither is a clean UX.

       On denial / unavailability / timeout we render an inline rose
       error node and leave the rest of the page state untouched.
       The dashboard hides the entire card on denial because the
       user can recover on the next mount; here the user is
       deliberately trying to manage the location, so the visible
       error is the right surface. --%>
  <div id="location-card" data-has-location={not is_nil(@current_scope.user.latitude)}>
    <.header>
      {gettext("Location")}
      <:subtitle>
        {gettext(
          "Used for sunrise/sunset markers, the local cloud-cover card, and your timezone offset."
        )}
      </:subtitle>
    </.header>

    <%= case format_location(@current_scope.user) do %>
      <% {:set, display} -> %>
        <p class="mt-2 text-sm text-zinc-700 dark:text-zinc-200" data-test="location-display">
          {display}
        </p>
        <div class="mt-3 flex flex-wrap items-center gap-3">
          <button
            type="button"
            id="location-update-btn"
            data-request-location
            data-loading-label={gettext("Requesting…")}
            class="inline-flex items-center gap-1.5 rounded-md bg-sky-600 px-2.5 py-1.5 text-xs font-medium text-white shadow-sm hover:bg-sky-500 focus:outline-none focus:ring-2 focus:ring-sky-500 focus:ring-offset-1 dark:focus:ring-offset-zinc-800"
          >
            <.icon name="hero-map-pin" class="h-4 w-4" />
            {gettext("Update location")}
          </button>

          <.form
            :let={_f}
            for={@settings_changeset}
            action={~p"/users/settings"}
            id="clear_location_form"
            class="inline"
          >
            <input type="hidden" name="action" value="clear_location" />
            <button
              type="submit"
              phx-disable-with={gettext("Clearing...")}
              class="text-sm text-rose-600 hover:text-rose-700 underline-offset-2 hover:underline"
            >
              {gettext("Clear")}
            </button>
          </.form>
        </div>
      <% :unset -> %>
        <p class="mt-2 text-xs text-zinc-500 dark:text-zinc-400">
          {gettext(
            "No location stored. The dashboard can show local cloud cover, sunrise/sunset markers, and your timezone offset once you share it."
          )}
        </p>
        <button
          type="button"
          id="location-share-btn"
          data-request-location
          data-loading-label={gettext("Requesting…")}
          class="mt-3 inline-flex items-center gap-1.5 rounded-md bg-sky-600 px-2.5 py-1.5 text-xs font-medium text-white shadow-sm hover:bg-sky-500 focus:outline-none focus:ring-2 focus:ring-sky-500 focus:ring-offset-1 dark:focus:ring-offset-zinc-800"
        >
          <.icon name="hero-map-pin" class="h-4 w-4" />
          {gettext("Share location")}
        </button>
    <% end %>

    <%!-- Server-side validation errors from the failed location
         changeset. We render the field-specific message next to
         the location card so the user sees what to fix without
         scrolling back through the page. The browser-side denial
         path uses the [data-location-error] node below; these two
         are separate surfaces because the JS path doesn't reload
         the page (the form fails client-side and the button
         re-enables), while the server-side path returns the page
         with the failed changeset already in the assigns. --%>
    <%= if @location_changeset do %>
      <%= for {field, msg} <- @location_changeset.errors do %>
        <p class="mt-2 text-sm text-rose-600 dark:text-rose-400">
          {humanize_field(field)}: {elem(msg, 0)}
        </p>
      <% end %>
    <% end %>

    <p
      data-location-error
      hidden
      role="alert"
      class="mt-2 text-sm text-rose-600 dark:text-rose-400"
    >
      {gettext(
        "Couldn't read your location. Check the site's location permission in your browser settings, then try again."
      )}
    </p>
  </div>

  <div class="divider" />

  <%!-- Energy rate for the dashboard's "Saved this month" card. The
       form posts a decimal €/kWh value as a plain string; the
       User.settings_changeset/2 converts it to whole cents and casts
       into the cents_per_kwh column. The hidden action routes to
       `update_settings/2` in UserSettingsController. --%>
  <.form :let={_f} for={@settings_changeset} action={~p"/users/settings"} id="update_settings">
    <input type="hidden" name="action" value="update_settings" />

    <.input
      name="euros_per_kwh"
      id="euros_per_kwh"
      type="number"
      step="0.01"
      min="0.01"
      max="100"
      label={gettext("Energy rate (€/kWh)")}
      value={
        # Prefill the input with the user's stored €/kWh rate.
        #
        # `fetch_field/2` returns the changeset's `:changes` value if
        # present, otherwise the `:data` value. On a fresh GET the
        # settings_changeset/2 always puts something in `:changes`
        # (the empty-input branch produces `cents = nil`), so it never
        # falls back to `:data` and the input renders empty even
        # though the user has a stored rate. Read `:data` first
        # (the user's actual stored value), then fall back to
        # `:changes` for the post-failed-POST case where the user has
        # typed something. Treat any `nil` (cleared field) as empty.
        cents =
          case @settings_changeset do
            %Ecto.Changeset{data: %DtuApp.Accounts.User{cents_per_kwh: cents}}
            when is_integer(cents) ->
              cents

            _ ->
              case Ecto.Changeset.fetch_field(@settings_changeset, :cents_per_kwh) do
                {_, cents} when is_integer(cents) -> cents
                _ -> nil
              end
          end

        case cents do
          c when is_integer(c) -> :erlang.float_to_binary(c / 100.0, decimals: 2)
          _ -> ""
        end
      }
      placeholder="0.32"
    />
    <p class="mt-1 text-xs text-zinc-500 dark:text-zinc-400">
      {gettext(
        "Used to calculate how much your solar production saved you this month. Leave empty to hide the savings card."
      )}
    </p>

    <%= if error = Keyword.get(@settings_changeset.errors, :cents_per_kwh) do %>
      <p class="mt-1 text-sm text-rose-600 dark:text-rose-400">
        {elem(error, 0)}
      </p>
    <% end %>

    <%!-- Language for the dashboard UI, browser notifications, and
         transactional emails. Mirrors the same set `Plugs.Locale`
         and `User.@supported_locales` resolve against; the changeset
         rejects anything else. Prefilled from the user's stored
         locale so re-opening the page doesn't drop the selection. --%>
    <.input
      name="locale"
      id="locale"
      type="select"
      label={gettext("Language")}
      value={@current_scope.user.locale}
      options={[
        {gettext("English"), "en"},
        {gettext("Deutsch"), "de"},
        {gettext("Français"), "fr"}
      ]}
    />

    <%= if error = Keyword.get(@settings_changeset.errors, :locale) do %>
      <p class="mt-1 text-sm text-rose-600 dark:text-rose-400">
        {elem(error, 0)}
      </p>
    <% end %>

    <.button variant="primary" phx-disable-with={gettext("Saving...")}>
      {gettext("Save Settings")}
    </.button>
  </.form>

  <%!-- Inline geolocation flow for the Location section above.
       Lives here (not as a colocated hook) because this page is
       controller-rendered, not a LiveView — `<script
       :type={Phoenix.LiveView.ColocatedHook}>` only resolves
       inside LV templates. The script binds to every
       `[data-request-location]` element (Share / Update buttons),
       reads `navigator.geolocation` on click, and submits a hidden
       form whose `action=update_location` lands in the
       UserSettingsController dispatch. On any failure path
       (no API, PERMISSION_DENIED, POSITION_UNAVAILABLE, TIMEOUT)
       we reveal the `[data-location-error]` node and leave the
       rest of the page alone — unlike the dashboard, the user
       is actively managing settings so they need the visible
       error to recover. --%>
  <script>
    (function () {
      function findErrorNode() {
        return document.querySelector("[data-location-error]");
      }

      function showError() {
        var node = findErrorNode();
        if (node) node.hidden = false;
      }

      function buildForm(action, latitude, longitude) {
        var form = document.createElement("form");
        form.method = "post";
        form.action = "/users/settings";
        form.style.display = "none";

        var fields = {
          "_csrf_token": document.querySelector("meta[name='csrf-token']")?.getAttribute("content") || "",
          "action": action,
          "latitude": latitude,
          "longitude": longitude
        };

        Object.keys(fields).forEach(function (name) {
          var input = document.createElement("input");
          input.type = "hidden";
          input.name = name;
          input.value = fields[name];
          form.appendChild(input);
        });

        return form;
      }

      function beginLoading(button, originalLabel) {
        button.disabled = true;
        var loadingLabel = button.getAttribute("data-loading-label");
        if (loadingLabel) {
          button.setAttribute("data-original-label", originalLabel);
          // Replace just the trailing text node so the icon stays put.
          var textNode = Array.from(button.childNodes).find(function (n) {
            return n.nodeType === Node.TEXT_NODE;
          });
          if (textNode) {
            textNode.textContent = " " + loadingLabel;
          } else {
            button.appendChild(document.createTextNode(" " + loadingLabel));
          }
        }
      }

      document.addEventListener("click", function (event) {
        var button = event.target.closest("[data-request-location]");
        if (!button) return;
        event.preventDefault();

        // Bail if a previous click is still pending — the browser
        // would drop the second prompt anyway, but the visual state
        // stays cleaner if we don't even try.
        if (button.disabled) return;

        if (!navigator.geolocation) {
          showError();
          return;
        }

        var originalLabel = button.textContent.trim();
        beginLoading(button, originalLabel);

        // Hide any prior error so the retry has a clean slate.
        var errNode = findErrorNode();
        if (errNode) errNode.hidden = true;

        navigator.geolocation.getCurrentPosition(
          function (pos) {
            var form = buildForm(
              "update_location",
              pos.coords.latitude,
              pos.coords.longitude
            );
            document.body.appendChild(form);
            form.submit();
          },
          function () {
            // PERMISSION_DENIED (1) / POSITION_UNAVAILABLE (2) /
            // TIMEOUT (3) all collapse to "show the error node,
            // restore the button" from the user's POV. The browser's
            // site-settings is the recovery surface.
            showError();
            button.disabled = false;
            var original = button.getAttribute("data-original-label");
            if (original !== null) {
              var textNode = Array.from(button.childNodes).find(function (n) {
                return n.nodeType === Node.TEXT_NODE;
              });
              if (textNode) {
                textNode.textContent = " " + original;
              }
            }
          },
          // 10s is well above the typical 1–3s fix time but well
          // below the user's patience for a "loading" state.
          // maximumAge: 0 forces a fresh read rather than the cached
          // value the dashboard auto-prompt may have used.
          { timeout: 10000, maximumAge: 0 }
        );
      });
    })();
  </script>
</Layouts.app>
